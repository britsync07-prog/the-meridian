  "paid_plan_decision_rule": {
    "version": 1,
    "updated_on": "2026-10-20",
    "triggers": [
      {
        "id": "traffic",
        "metric": "daily_visitors",
        "threshold": 4000,
        "unit": "visitors/day",
        "comparison": "approaching",
        "source_requirement": "OPS-04",
        "decision_ref": "D-08"
      },
      {
        "id": "static_files",
        "metric": "static_files_per_project",
        "threshold": 20000,
        "unit": "files",
        "comparison": "exceeding",
        "source_requirement": "OPS-04",
        "decision_ref": "D-06"
      },
      {
        "id": "revenue",
        "metric": "monthly_revenue_usd",
        "threshold": 1,
        "unit": "USD/month",
        "comparison": "any",
        "source_requirement": "OPS-04",
        "decision_ref": "D-05"
      }
    ],
    "standing_disposition": "never_purchase",
    "standing_decision_ref": "D-05",
    "standing_decision_text": "The free tier is a permanent hard ceiling. The project never buys Workers Paid or any other paid tier, not even after the site earns revenue. Revenue is not a licence to spend on infrastructure.",
    "response_mechanisms": [
      "promote_hot_stories_into_the_static_tier",
      "edge_cache_the_story_tier_hard",
      "shard_the_static_tier_across_the_8_projects"
    ],
    "response_decision_ref": "D-07",
    "request_ceiling_is_a_permanent_wall_ref": "D-08",
    "known_non_conforming_dependency": {
      "id": "open_meteo",
      "requirement_ref": "D-09",
      "issue": "The Open-Meteo free tier is restricted to non-commercial use and requires CC BY 4.0 attribution.",
      "standing_obligation": "A free, commercially-usable weather replacement must be sourced before the site earns any revenue.",
      "explicitly_excluded": "Buying the Open-Meteo paid Standard plan when that moment comes."
    }
  }
