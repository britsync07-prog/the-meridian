{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meridian",
      "database_id": "af7ca858-b8ce-432a-8e80-a05c39e3c1be",
      "migrations_dir": "../../shared/db",
      "migrations_table": "d1_migrations",
      "migrations_pattern": "../../shared/db/[0-9]*.sql"
    }
  ],
  "vars": {
    "MERIDIAN_DB_ID": "af7ca858-b8ce-432a-8e80-a05c39e3c1be"
  },
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "meridian" }
  ],
  "triggers": {
    "crons": [
      "0,15,30,45 * * * *",
      "5,20,35,50 * * * *",
      "10,25,40,55 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c7ee93b7d9a6497787f40b1d441469ae"
    }
  ]
}
