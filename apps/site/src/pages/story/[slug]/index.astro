---
import StoryLayout from '../../../layouts/StoryLayout.astro';
import StoryList from '../../../components/StoryList.astro';
import FlagSource from '../../../components/FlagSource.astro';
import ReportError from '../../../components/ReportError.astro';
import MediaImage from '../../../components/MediaImage.astro';
import { SITE_ORIGIN } from '../../../../../../shared/config/site.ts';
import { getStoryPageData, getAllStorySlugs, loadPageSnapshot } from '../../../lib/page-data.ts';

export async function getStaticPaths() {
  await loadPageSnapshot();
  return getAllStorySlugs().map(slug => ({
    params: { slug },
    props: { slug }
  }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const data = getStoryPageData(slug);

if (!data) {
  Astro.response?.status(404);
}

const today = new Date().toISOString().split('T')[0];
const publishedDate = data?.cluster?.publishedAt
  ? new Date(data.cluster.publishedAt).toISOString().split('T')[0]
  : today;
const storyPath = `/story/${slug}/`;
const storyDescription = data.sources.length > 0
  ? `${data.sources.map(s => s.headline).join(' | ')}`.substring(0, 160)
  : data.cluster.canonicalHeadline;

// OPS-22/23: Load any correction note if it exists
let correctionNote = null;
try {
  const correctionPath = `../data/corrections/${slug}.json`;
  // In production, this would read from R2 or a pre-built JSON file
} catch {
  // Correction note not found, page still renders
}
---
<StoryLayout
  storyTitle={data.cluster.canonicalHeadline}
  edition={data.edition}
  date={today}
  path={storyPath}
  description={storyDescription}
  publishedDate={publishedDate}
  imageUrl={`${SITE_ORIGIN}/og/${slug}.jpg`}
  tags={data.topics}
  section={data.section}
>
  <div slot="body" class="story-page-body">
    {data.image && (
      <>
        <MediaImage
          src={data.image.src}
          srcset={data.image.srcset}
          alt={data.image.alt}
          width={1200}
          height={675}
          priority={true}
          class="w-full h-auto object-cover mb-6"
        />
        {data.image.credit && <p class="text-caption text-muted -mt-4 mb-6">{data.image.credit}</p>}
      </>
    )}
    <div class="story-page-meta">
      <span>{data.edition === 'in-hi' ? `खंड: ${data.brief.sectionName}` : `Section: ${data.sectionName}`}</span>
      <time datetime={publishedDate}>{data.edition === 'in-hi' ? `प्रकाशित: ${publishedDate}` : `Published: ${publishedDate}`}</time>
      {data.cluster.coverageCount > 0 && (
        <span>{data.edition === 'in-hi' ? `${data.cluster.coverageCount} स्रोतों की कवरेज` : `${data.cluster.coverageCount} outlet${data.cluster.coverageCount > 1 ? 's' : ''} covering`}</span>
      )}
      {data.cluster.trendingScore > 9 && (
        <span class="text-accent font-medium">Trending ({data.cluster.trendingScore.toFixed(1)})</span>
      )}
    </div>

    <div>
      <section class="story-brief" aria-labelledby="meridian-brief">
        <p class="story-brief-label">{data.brief.label}</p>
        <h2 id="meridian-brief">{data.brief.heading}</h2>
        <p class="story-brief-introduction">{data.brief.introduction}</p>
        {data.brief.reportedContext && <blockquote class="story-brief-context"><p>{data.brief.reportedContext}</p><cite>{data.brief.contextAttribution}</cite></blockquote>}
        <dl class="story-facts">
          {data.brief.keyFacts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
        <p class="story-brief-coverage">{data.brief.coverage}</p>
        <p class="story-brief-disclosure">{data.brief.disclosure}</p>
      </section>

      <h2>{data.brief.sourceHeading}</h2>
      <ul class="story-page-sources">
        {data.sources.map(source => (
          <li key={`${source.sourceId}-${source.rank}`} class="mb-2">
            <a href={source.url} class="text-ink no-underline hover:text-accent" target="_blank" rel="noopener">
              {source.sourceName} - {source.headline}
            </a>
            <span class="text-caption text-muted"> (Rank {source.rank})</span>
          </li>
        ))}
      </ul>

      {data.relatedStories.length > 0 && <section class="story-page-related" aria-labelledby="related-stories"><h2 id="related-stories">{data.edition === 'in-hi' ? `${data.brief.relatedPrefix} ${data.brief.sectionName}` : `${data.brief.relatedPrefix} ${data.sectionName} from this edition`}</h2><StoryList stories={data.relatedStories} edition={data.edition} /></section>}
    </div>

    {/* OPS-22/23: User affordances */}
    <FlagSource storySlug={slug} />
    <ReportError storySlug={slug} />

    {correctionNote && (
      <div class="correction-note mt-8 p-4 border hairline-md bg-warning/10">
        <h3 class="font-bold mb-2">Correction</h3>
        <p class="text-sm">{correctionNote.text}</p>
        <time class="text-caption text-muted">{correctionNote.date}</time>
      </div>
    )}
  </div>
</StoryLayout>
