---
import FrontLayout from '../layouts/FrontLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import MostCovered from '../components/MostCovered.astro';
import EditorPicks from '../components/EditorPicks.astro';
import SectionGrid from '../components/SectionGrid.astro';
import { getFrontPageData } from '../lib/page-data.ts';
import { SITE_NAME } from '../../../../shared/config/site.ts';

const edition = 'uk';
const data = getFrontPageData(edition);
const today = data?.date ?? new Date().toISOString().split('T')[0];
---

<FrontLayout edition={edition} date={today} path="/" title="Latest news" description="A free, automatically-curated daily paper for seven countries.">
  {data ? (
    <>
      {data.leadStory && <LeadStory story={data.leadStory} edition={edition} />}
      <SectionGrid data={data} />
      <div class="front-supplement">
        <MostCovered stories={data.mostCovered} title="Most Covered" edition={edition} limit={5} excludeSlug={data.leadStory?.cluster.slug} />
        {data.editorPicks.length > 0 && <EditorPicks stories={data.editorPicks} edition={edition} excludeSlug={data.leadStory?.cluster.slug} />}
      </div>
    </>
  ) : (
    <section class="publication-pause">
      <p class="story-kicker">The daily paper</p>
      <h1>{SITE_NAME}</h1>
      <p>Today&rsquo;s editions are being verified. Choose a published country edition when it is ready.</p>
      <nav aria-label="Editions" class="edition-picker">
        <a href="/uk/">United Kingdom</a><a href="/us/">United States</a><a href="/au/">Australia</a><a href="/ca/">Canada</a><a href="/ie/">Ireland</a><a href="/nz/">New Zealand</a><a href="/in/">India</a><a href="/in-hi/">हिंदी</a>
      </nav>
    </section>
  )}
</FrontLayout>
