---
import FrontLayout from '../layouts/FrontLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import MostCovered from '../components/MostCovered.astro';
import EditorPicks from '../components/EditorPicks.astro';
import SectionGrid from '../components/SectionGrid.astro';
import { getFrontPageData } from '../lib/page-data.ts';

const edition = 'uk';
const data = getFrontPageData(edition);
const today = data?.date ?? new Date().toISOString().split('T')[0];
---

<FrontLayout edition={edition} date={today} path="/" title="Latest news" description="A free, automatically-curated daily paper for seven countries.">
  {data ? (
    <>
      {data.leadStory && <LeadStory story={data.leadStory} edition={edition} />}
      <SectionGrid data={data} />
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
        <MostCovered stories={data.mostCovered} title="Most Covered" edition={edition} />
        {data.editorPicks.length > 0 && <EditorPicks stories={data.editorPicks} edition={edition} />}
      </div>
    </>
  ) : (
    <section class="col-span-full py-16 text-center">
      <h1 class="font-masthead text-h1 font-bold italic">The Meridian</h1>
      <p class="text-deck text-muted mt-4">Today’s edition is being prepared. Choose an edition to explore the paper.</p>
      <nav aria-label="Editions" class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-3">
        <a href="/uk/">United Kingdom</a><a href="/us/">United States</a><a href="/au/">Australia</a><a href="/ca/">Canada</a><a href="/ie/">Ireland</a><a href="/nz/">New Zealand</a><a href="/in/">India</a><a href="/in-hi/">भारत</a>
      </nav>
    </section>
  )}
</FrontLayout>
