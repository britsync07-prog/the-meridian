---
import StoryLayout from '../../../../layouts/StoryLayout.astro';
import StoryList from '../../../../components/StoryList.astro';
import FlagSource from '../../../../components/FlagSource.astro';
import ReportError from '../../../../components/ReportError.astro';
import MediaImage from '../../../../components/MediaImage.astro';
import { SITE_ORIGIN } from '../../../../../../../shared/config/site.ts';
import { getEditionStoryPaths, getStoryPageData, loadPageSnapshot } from '../../../../lib/page-data.ts';

export async function getStaticPaths() {
  await loadPageSnapshot();
  return getEditionStoryPaths().map(({ edition, slug }) => ({ params: { edition, slug }, props: { edition, slug } }));
}

interface Props { edition: string; slug: string; }
const { edition, slug } = Astro.props;
const data = getStoryPageData(slug, edition);
if (!data) Astro.response?.status(404);

const publishedDate = data?.cluster?.publishedAt
  ? new Date(data.cluster.publishedAt).toISOString().split('T')[0]
  : new Date().toISOString().split('T')[0];
const storyPath = `/${edition}/story/${slug}/`;
const storyDescription = data?.sources.length
  ? data.sources.map((source) => source.headline).join(' | ').slice(0, 160)
  : data?.cluster.canonicalHeadline ?? '';
---
<StoryLayout
  storyTitle={data.cluster.canonicalHeadline}
  edition={edition}
  date={publishedDate}
  path={storyPath}
  description={storyDescription}
  publishedDate={publishedDate}
  imageUrl={`${SITE_ORIGIN}/og/${slug}.jpg`}
  tags={data.topics}
  section={data.section}
>
  <div slot="body" class="mb-8">
    {data.image && (
      <>
        <MediaImage src={data.image.src} srcset={data.image.srcset} alt={data.image.alt} width={1200} height={675} priority={true} class="w-full h-auto object-cover mb-6" />
        {data.image.credit && <p class="text-caption text-muted -mt-4 mb-6">{data.image.credit}</p>}
      </>
    )}
    <div class="flex flex-wrap gap-4 text-caption text-muted mb-6">
      <span>{data.sectionName}</span>
      <time datetime={publishedDate}>Published: {publishedDate}</time>
      {data.cluster.coverageCount > 0 && <span>{data.cluster.coverageCount} reporting outlet{data.cluster.coverageCount === 1 ? '' : 's'}</span>}
    </div>
    {data.cluster.canonicalExcerpt && <p class="text-deck text-muted mb-6">{data.cluster.canonicalExcerpt}</p>}
    <h2 class="font-masthead text-h2 font-bold italic mb-3">Original reporting</h2>
    <ul class="mb-6">
      {data.sources.map((source) => (
        <li class="mb-2"><a href={source.url} class="text-ink no-underline hover:text-accent" target="_blank" rel="noopener">{source.sourceName} — {source.headline}</a></li>
      ))}
    </ul>
    {data.entities.length > 0 && <><h2 class="font-masthead text-h2 font-bold italic mb-3">People and places</h2><p class="text-deck text-muted mb-6">{data.entities.join(', ')}</p></>}
    <div class="mt-8"><StoryList stories={data.relatedStories} edition={edition} /></div>
    <FlagSource storySlug={slug} />
    <ReportError storySlug={slug} />
  </div>
</StoryLayout>
