---
import FrontLayout from '../../layouts/FrontLayout.astro';
import LeadStory from '../../components/LeadStory.astro';
import MostCovered from '../../components/MostCovered.astro';
import EditorPicks from '../../components/EditorPicks.astro';
import SectionGrid from '../../components/SectionGrid.astro';
import { getFrontPageData, getEditions } from '../../lib/page-data.ts';

export function getStaticPaths() {
  return getEditions().map(e => ({
    params: { edition: e },
    props: { edition: e }
  }));
}

interface Props {
  edition: string;
}

const { edition } = Astro.props;
const data = getFrontPageData(edition);
const today = data?.date ?? new Date().toISOString().split('T')[0];
const editionObj = getEditions().find(e => e === edition);
const path = editionObj ? `/${editionObj}/` : '/';
const frontTitle = data?.leadStory?.cluster.canonicalHeadline
  ? `${data.leadStory.cluster.canonicalHeadline} | ${edition.toUpperCase()}`
  : `Latest news from ${edition.toUpperCase()}`;
---
{data ? (
  <FrontLayout edition={edition} date={today} path={path} title={frontTitle} description="Top stories from today's edition.">
    {data.leadStory && <LeadStory story={data.leadStory} edition={edition} />}
    <SectionGrid data={data} />
    <div class="front-supplement">
      <MostCovered stories={data.mostCovered} title={edition === 'in-hi' ? 'सबसे ज़्यादा कवरेज' : 'Most Covered'} edition={edition} limit={5} excludeSlug={data.leadStory?.cluster.slug} />
      {data.editorPicks.length > 0 && <EditorPicks stories={data.editorPicks} edition={edition} excludeSlug={data.leadStory?.cluster.slug} title={edition === 'in-hi' ? 'संपादक की पसंद' : undefined} />}
    </div>
  </FrontLayout>
) : (
  <FrontLayout edition={edition} date={today} path={path} title={frontTitle} description="Top stories from today's edition.">
    <section class="publication-pause">
      <p class="story-kicker">Publication paused</p>
      <h1>This edition has not passed today&rsquo;s publication checks.</h1>
      <p>We keep the last verified edition live rather than filling the paper with incomplete coverage.</p>
      <a href="/">Choose another edition</a>
    </section>
  </FrontLayout>
)}
