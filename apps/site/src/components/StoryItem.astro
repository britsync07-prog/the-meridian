---
import type { PageStory } from '../lib/page-data.ts';

interface Props {
  story: PageStory;
  edition: string;
  isSecondary?: boolean;
}

const { story, edition, isSecondary = false } = Astro.props;
const { cluster, sources } = story;
const publishedDate = new Date(cluster.publishedAt).toISOString().split('T')[0];
const primarySource = sources[0];
const isHindi = edition === 'in-hi';
---

<article class:list={['story-item', { 'story-item-compact': isSecondary }]}>
  <h3 class="story-item-headline">
    <a href={`/${edition}/story/${cluster.slug}/`}>
      {cluster.canonicalHeadline}
    </a>
  </h3>
  {primarySource && (
    <p class="story-meta">
      <span>{primarySource.sourceName}</span>
      <time datetime={publishedDate}>{publishedDate}</time>
      <span>{isHindi ? `${cluster.coverageCount} स्रोत` : `${cluster.coverageCount} outlet${cluster.coverageCount === 1 ? '' : 's'}`}</span>
    </p>
  )}
  {cluster.canonicalExcerpt && <p class="story-item-deck">{cluster.canonicalExcerpt}</p>}
  {cluster.trendingScore > 9 && (
    <span class="story-trending">
      {isHindi ? 'ट्रेंडिंग' : 'Trending'}
    </span>
  )}
</article>
