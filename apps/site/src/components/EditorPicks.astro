---
import type { PageStory } from '../lib/page-data.ts';
import StoryItem from './StoryItem.astro';

interface Props {
  stories: PageStory[];
  edition: string;
  excludeSlug?: string;
  title?: string;
}

const { stories, edition, excludeSlug, title = 'Editor\'s Picks' } = Astro.props;
const visibleStories = stories.filter((story) => story.cluster.slug !== excludeSlug);
---

<aside class="coverage-panel">
  <h2 class="panel-heading">
    {title}
  </h2>
  <div>
    {visibleStories.map(story => (
      <StoryItem story={story} edition={edition} isSecondary={true} />
    ))}
  </div>
</aside>
