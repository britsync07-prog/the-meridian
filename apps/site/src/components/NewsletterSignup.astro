---
/**
 * Newsletter signup form component.
 *
 * GRO-01: Reader can subscribe to daily digest for one edition
 * GRO-04: Form submits server-side; API key never reaches browser
 * GRO-05: Form sits outside critical rendering path (below fold)
 */

interface Props {
  edition: string;
}

const { edition } = Astro.props;

const EDITIONS = [
  { id: 'uk', name: 'United Kingdom' },
  { id: 'us', name: 'United States' },
  { id: 'au', name: 'Australia' },
  { id: 'ca', name: 'Canada' },
  { id: 'ie', name: 'Ireland' },
  { id: 'nz', name: 'New Zealand' },
  { id: 'in', name: 'India' },
  { id: 'in-hi', name: 'India (Hindi)' },
];
---

<!-- Newsletter signup — positioned below fold, outside critical rendering path -->
<div class="newsletter-signup mt-12 pt-8 border-t hairline-md" role="form" aria-labelledby="newsletter-heading">
  <h2 id="newsletter-heading" class="font-masthead text-h2 font-bold italic mb-4">
    Daily Digest
  </h2>
  <p class="text-deck text-muted mb-4">
    Get the day's top stories delivered to your inbox. One email per day, for your edition.
  </p>

  <form
    action="/api/newsletter/subscribe"
    method="POST"
    class="flex flex-col sm:flex-row gap-3"
  >
    <select
      name="edition"
      aria-label="Select edition"
      class="flex-1 px-3 py-2 border hairline-md rounded bg-surface text-ink"
      required
    >
      {EDITIONS.map(e => (
        <option value={e.id} selected={e.id === edition}>
          {e.name}
        </option>
      ))}
    </select>

    <input
      type="email"
      name="email"
      placeholder="your@email.com"
      aria-label="Email address"
      required
      class="flex-1 px-3 py-2 border hairline-md rounded bg-surface text-ink"
    />

    <button
      type="submit"
      class="px-4 py-2 bg-accent text-white font-medium rounded hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
    >
      Subscribe
    </button>
  </form>

  <p class="text-caption text-muted mt-3">
    By subscribing, you agree to receive one daily email for your selected edition.
    Unsubscribe anytime.
  </p>
</div>
