---
import type { PageStory } from '../lib/page-data.ts';
import MediaImage from './MediaImage.astro';

interface Props {
  story: PageStory;
  edition: string;
}

const { story, edition } = Astro.props;
const { cluster, sources } = story;
const publishedDate = new Date(cluster.publishedAt).toISOString().split('T')[0];
---

<article class:list={['lead-story', { 'lead-story-no-image': !story.image }]}>
  {story.image && (
    <>
      <MediaImage
        src={story.image.src}
        srcset={story.image.srcset}
        alt={story.image.alt}
        width={800}
        height={450}
        priority={true}
        class="lead-story-image"
      />
      {story.image.credit && <p class="image-credit">{story.image.credit}</p>}
    </>
  )}
  <h1 class="lead-story-headline">
    <a href={`/story/${cluster.slug}/`}>
      {cluster.canonicalHeadline}
    </a>
  </h1>
  {cluster.canonicalExcerpt && <p class="lead-story-deck">{cluster.canonicalExcerpt}</p>}
  <div class="story-meta">
    <time datetime={publishedDate}>{publishedDate} · {edition.toUpperCase()} · {cluster.coverageCount} reporting outlet{cluster.coverageCount === 1 ? '' : 's'}</time>
    {sources.slice(0, 3).map(source => <span>{source.sourceName}</span>)}
  </div>
</article>
