---
/**
 * Flag source component — OPS-22.
 * Reader can flag a source from any story page.
 * Flagged content enters review queue without publishing.
 */

interface Props {
  storySlug: string;
}

const { storySlug } = Astro.props;
---

<div class="reader-feedback">
  <details class="group">
    <summary class="cursor-pointer text-caption text-muted hover:text-ink focus:outline-none">
      Flag a source issue
    </summary>

    <form
      action="/api/reports/flag"
      method="POST"
      class="reader-feedback-form"
    >
      <input type="hidden" name="story_slug" value={storySlug} />
      <input type="hidden" name="type" value="flag" />

      <div>
        <label for="flag-reason" class="block text-sm font-medium mb-1">Reason</label>
        <select
          id="flag-reason"
          name="reason"
          class="reader-input"
          required
        >
          <option value="">Select a reason...</option>
          <option value="inaccurate">Inaccurate information</option>
          <option value="broken_link">Broken link</option>
          <option value="outdated">Outdated content</option>
          <option value="offensive">Offensive content</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div>
        <label for="flag-comment" class="block text-sm font-medium mb-1">
          Comment (optional)
        </label>
        <textarea
          id="flag-comment"
          name="comment"
          rows={3}
          class="reader-input"
          placeholder="Additional details..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="reader-button reader-button-muted"
      >
        Submit Flag
      </button>
    </form>

    <p class="text-caption text-muted mt-2">
      Your flag will be reviewed by our team. No action will be taken until reviewed.
    </p>
  </details>
</div>
