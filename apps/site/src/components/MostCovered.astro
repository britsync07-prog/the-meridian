---
import type { PageStory } from '../lib/page-data.ts';
import StoryItem from './StoryItem.astro';

interface Props {
  stories: PageStory[];
  title: string;
  edition: string;
  limit?: number;
  excludeSlug?: string;
}

const { stories, title, edition, limit, excludeSlug } = Astro.props;
const visibleStories = stories.filter((story) => story.cluster.slug !== excludeSlug).slice(0, limit);
---

<aside class="coverage-panel">
  <h2 class="panel-heading">
    {title}
  </h2>
  <div>
    {visibleStories.map(story => (
      <StoryItem story={story} edition={edition} isSecondary={true} />
    ))}
  </div>
</aside>
