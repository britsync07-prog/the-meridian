---
import Base from './Base.astro';
interface Props {
  storyTitle?: string;
  edition?: string;
  date?: string;
}
const { storyTitle = 'Story', edition = 'UK', date = new Date().toISOString().split('T')[0] } = Astro.props;
---
<Base edition={edition} date={date}>
  <article class="prose lg:prose-xl mx-auto max-w-none">
    <h1 class="font-masthead text-h1 font-bold italic mb-4">{storyTitle}</h1>
    <time datetime={date} class="text-caption text-muted mb-6 block">{date}</time>
    <slot name="body" />
  </article>
</Base>
