---
import Base from './Base.astro';
interface Props {
  topicName?: string;
  edition?: string;
  date?: string;
  path?: string;
  title?: string;
  description?: string;
}
const { topicName = 'Topic', edition = 'UK', date = new Date().toISOString().split('T')[0], path = '/', title, description } = Astro.props;
---
<Base edition={edition} date={date} path={path} title={title} description={description}>
  <header class="listing-header">
    <p class="story-kicker">Topic index</p>
    <h1>{topicName}</h1>
  </header>
  <div class="front-grid">
    <slot />
  </div>
</Base>
