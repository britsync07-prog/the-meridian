---
import { SITE_NAME, SITE_ORIGIN } from '../../../../shared/config/site.ts';
import { pageMeta, renderHead } from '../../../../shared/templates/head.ts';
import { buildHreflang } from '../../../../shared/templates/hreflang.ts';
import { renderOpenGraph } from '../../../../shared/templates/og-meta.ts';
import { buildOrganizationSchema, renderSchema } from '../../../../shared/templates/schema.ts';
import type { PageMetaInput } from '../../../../shared/types.ts';
import type { EditionId } from '../../../../shared/config/editions.ts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  htmlLang?: string;
  edition?: EditionId;
  date?: string;
  path?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title = 'Latest news',
  description = 'A free, automatically-curated daily paper for seven countries.',
  htmlLang = 'en',
  edition = 'uk' as EditionId,
  date = new Date().toISOString().split('T')[0],
  path = '/',
  alternates = [],
} = Astro.props;

// Build page metadata using the single source of truth
const metaInput: PageMetaInput = {
  title,
  description,
  path,
  edition,
  alternates: buildHreflang(edition, path),
};
const meta = pageMeta(metaInput);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={renderHead(meta)} />
    <Fragment set:html={renderOpenGraph(meta)} />
    <Fragment set:html={renderSchema(buildOrganizationSchema({ name: SITE_NAME, url: SITE_ORIGIN, logoUrl: `${SITE_ORIGIN}/favicon.ico`, sameAs: [] }))} />
    <link rel="preload" href="/fonts/PlayfairDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NotoSerifDevanagari-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- DSN-06: skip-to-content link, first Tab stop -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <!-- DSN-05: sticky masthead at 56px -->
    <header class="masthead">
      <div class="flex items-center gap-4">
        <span class="text-edition font-semibold tracking-wide uppercase">
          {edition}
        </span>
        <span class="font-masthead text-2xl font-bold italic">{SITE_NAME}</span>
        <time datetime={date} class="text-muted text-sm">{date}</time>
      </div>
    </header>

    <main id="main-content" class="container flex-grow">
      <slot />
    </main>

    <!-- Print-style footer -->
    <footer class="border-t hairline-md py-6 mt-auto">
      <p class="text-center text-caption text-muted">
        {SITE_NAME} &mdash; automatically curated daily paper. No human editor.
      </p>
    </footer>
  </body>
</html>
