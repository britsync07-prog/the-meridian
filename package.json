{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Meridian — a free, automatically-curated daily news portal publishing a broadsheet edition per country.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest",
    "test:visual": "playwright test --config=apps/site/playwright.config.ts",
    "test:lighthouse": "node tests/lighthouse.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "astro build --root apps/site",
    "build:site": "astro build --root apps/site",
    "dev": "astro dev --root apps/site",
    "db:verify:local": "node scripts/db/verify-local.mjs",
    "db:verify:swap": "node scripts/db/verify-swap.mjs",
    "r2:lifecycle:verify": "node scripts/cloudflare/verify-lifecycle.mjs",
    "shards:split": "node scripts/shards/split-output.mjs",
    "shards:deploy": "node scripts/shards/deploy-all.mjs",
    "build:spike:s4": "node spikes/s-4-astro-throughput/generate.mjs",
    "ingest:local": "tsx scripts/ingest/run-local.ts",
    "cluster:split": "tsx scripts/curation/split-cluster.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "fast-xml-parser": "5.11.2",
    "satori": "^0.63.2",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.54.2",
    "@types/node": "24.19.2",
    "lighthouse": "^12.7.0",
    "tsx": "4.22.4",
    "ttf2woff2": "^8.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
