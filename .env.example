# Cloudflare (required for snapshot generation, R2 uploads, and CI)
CF_API_TOKEN=                 # Cloudflare API token with DNS/Edit and R2/D1 permissions
CF_ACCOUNT_ID=                # Your Cloudflare account ID
CF_D1_DATABASE_ID=            # D1 database ID (default: af7ca858-b8ce-432a-8e80-a05c39e3c1be)
R2_BUCKET_NAME=meridian       # R2 bucket name for snapshots and story pages

# Local development overrides
SNAPSHOT_PATH=                # Path to local gzipped snapshot JSON (CI sets this; omit for live D1 fetch)
MERIDIAN_D1_LOCAL_PATH=       # Local SQLite D1 path for local dev (e.g. ./data/meridian.db)

# Debug / feature flags
DEBUG_NEWSLETTER=false        # Set to 'true' to log newsletter KV operations to stdout

# External service integrations (optional — features gracefully degrade without them)
BREVO_WEBHOOK_URL=            # Brevo transactional email webhook URL (for newsletter delivery)
